# ==========================================
# EduCarieră / EduMind Production Configuration
# ==========================================

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/educariera?schema=public"
REDIS_URL="redis://redis:6379"

# Security & Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# App Ports & Hosts
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Email / Worker Settings (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="EduCarieră <no-reply@educariera.ro>"

# Storage (Coolify / MinIO / S3)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="/var/storage"
